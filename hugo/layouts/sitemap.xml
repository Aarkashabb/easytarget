{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range .Site.Pages }}
  {{- $kind := .Kind -}}
  {{- $robots := lower (printf "%v" .Params.robots) -}}
  {{- $noindexParam := lower (printf "%v" .Params.noindex) -}}
  {{- $isNoindex := or (eq $noindexParam "true") (in $robots "noindex") (hasSuffix .RelPermalink "/40/") -}}
  {{- if and (or (eq $kind "home") (eq $kind "section") (eq $kind "page")) (not $isNoindex) -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- with .Lastmod }}
    <lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}" />
    {{- end }}
  </url>
  {{- end -}}
{{- end }}
</urlset>
